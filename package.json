{
  "name": "voxel-wreck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./client --filter ./server dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "screenshots": "node scripts/screenshots.mjs",
    "diagrams": "node scripts/check-diagrams.mjs",
    "gallery": "node scripts/gallery.mjs",
    "start": "node server/dist/index.js"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  },
  "packageManager": "pnpm@10.28.0"
}
